{
  "name": "InvoiceSnap - ניהול קבלות",
  "short_name": "InvoiceSnap",
  "description": "צלם, ארגן ושלח קבלות לרואה חשבון בקליק אחד",
  "dir": "rtl",
  "lang": "he",
  "start_url": "/dashboard",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#0040a1",
  "background_color": "#f7f9fb",
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/api/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "image",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
